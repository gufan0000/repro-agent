{
  "name": "repro-agent",
  "version": "0.3.0",
  "description": "No repro, no issue. An agent that runs on the user's machine: diagnoses the problem, fixes what is safely fixable, and otherwise produces a bug report with real reproduction evidence.",
  "keywords": [
    "ai-agent",
    "bug-report",
    "issue-triage",
    "reproduction",
    "repro",
    "troubleshooting",
    "diagnostics",
    "support",
    "open-source-maintainers",
    "agents-md",
    "claude-code",
    "prompt-injection"
  ],
  "homepage": "https://github.com/gufan0000/repro-agent#readme",
  "bugs": "https://github.com/gufan0000/repro-agent/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gufan0000/repro-agent.git"
  },
  "license": "MIT",
  "author": "gufan0000",
  "type": "module",
  "bin": {
    "repro-agent": "dist/index.js",
    "repro": "dist/index.js"
  },
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./spec/task.schema.json": "./spec/task.schema.json",
    "./spec/project.schema.json": "./spec/project.schema.json"
  },
  "files": [
    "dist",
    "spec",
    "protocol",
    "adapters",
    "web",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "generate": "node tools/build-protocol.mjs",
    "build": "npm run generate && tsc -p tsconfig.json && node tools/build-web.mjs",
    "test": "npm run build && node tools/run-tests.mjs",
    "test:browser": "npm run build && node --test test/browser.e2e.mjs",
    "check": "npm run generate -- --check && tsc -p tsconfig.json && node tools/build-web.mjs --check",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.49.1",
    "typescript": "^5.7.2"
  }
}
