{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/gufan0000/repro-agent/main/spec/task.schema.json",
  "title": "Repro Agent Task",
  "description": "A self-contained diagnostic task handed to a local AI agent by an end user.",
  "type": "object",
  "required": ["protocol", "protocol_version", "language", "options", "project", "problem", "policy", "budget"],
  "additionalProperties": false,
  "properties": {
    "protocol": { "const": "repro-agent/task" },
    "protocol_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "task_id": { "type": "string" },
    "created_at": { "type": "string" },
    "language": { "enum": ["zh-CN", "en"] },

    "options": {
      "type": "object",
      "description": "The four user-selectable axes. Every one of them changes agent behaviour.",
      "required": ["agent_host", "region", "autonomy", "budget_profile"],
      "additionalProperties": false,
      "properties": {
        "agent_host": {
          "enum": ["generic", "workbuddy", "claude-code", "cursor", "codex", "cline", "other"],
          "default": "generic"
        },
        "region": {
          "enum": ["global", "china"],
          "description": "Selects the source-access fallback chain. 'china' puts mirrors first.",
          "default": "global"
        },
        "autonomy": {
          "enum": ["readonly", "guided", "auto-safe"],
          "description": "readonly = diagnose only, never modify. guided = ask before every change (default). auto-safe = may apply reversible low-risk fixes without asking, still asks for anything else.",
          "default": "guided"
        },
        "budget_profile": {
          "enum": ["frugal", "standard", "deep"],
          "description": "Scales the diagnostic budget for weak/free models vs. capable ones.",
          "default": "standard"
        }
      }
    },

    "project": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repository": {
          "type": "string",
          "description": "Canonical source repository URL. Empty is allowed: the agent then works from local evidence only.",
          "pattern": "^$|^https://[^\\s]+$"
        },
        "repository_public": { "type": "boolean", "default": true },
        "mirrors": {
          "type": "array",
          "description": "Alternative read routes, tried in order when the canonical host is unreachable.",
          "items": {
            "type": "object",
            "required": ["url"],
            "additionalProperties": false,
            "properties": {
              "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
              "kind": { "enum": ["gitcode", "gitee", "codeberg", "gitlab", "sourcehut", "mirror", "other"] },
              "note": { "type": "string" }
            }
          },
          "default": []
        },
        "deepwiki": {
          "type": "boolean",
          "description": "Allow the DeepWiki MCP tool as a last-resort comprehension aid for public repos.",
          "default": false
        },
        "docs_url": { "type": "string" },
        "issue_tracker": { "type": "string" },
        "version": { "type": "string" },
        "commit": { "type": "string", "pattern": "^$|^[0-9a-fA-F]{7,64}$" },
        "release_page": { "type": "string" }
      }
    },

    "problem": {
      "type": "object",
      "required": ["summary"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "expected": { "type": "string" },
        "observed": { "type": "string" },
        "reproduction_steps": { "type": "array", "items": { "type": "string" }, "default": [] },
        "frequency": { "enum": ["", "always", "often", "sometimes", "once"], "default": "" },
        "first_seen": { "type": "string" },
        "changed_recently": { "type": "string", "description": "What the user changed before it broke: update, new hardware, new config..." },
        "user_notes": { "type": "string" }
      }
    },

    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": { "enum": ["", "Windows", "macOS", "Linux", "Other"], "default": "" },
        "os_version": { "type": "string" },
        "architecture": { "enum": ["", "x64", "arm64", "x86"], "default": "" },
        "locale": { "type": "string" },
        "runtimes": { "type": "array", "items": { "type": "string" }, "default": [] }
      },
      "default": {}
    },

    "local_targets": {
      "type": "object",
      "description": "Where the agent is allowed to look. Locations only — never paste file contents here.",
      "additionalProperties": false,
      "properties": {
        "installation_paths": { "type": "array", "items": { "type": "string" }, "default": [] },
        "executable_paths": { "type": "array", "items": { "type": "string" }, "default": [] },
        "log_paths": { "type": "array", "items": { "type": "string" }, "default": [] },
        "config_paths": { "type": "array", "items": { "type": "string" }, "default": [] },
        "data_paths": { "type": "array", "items": { "type": "string" }, "default": [] },
        "process_names": { "type": "array", "items": { "type": "string" }, "default": [] },
        "service_names": { "type": "array", "items": { "type": "string" }, "default": [] },
        "ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 }, "default": [] },
        "registry_paths_read_only": { "type": "array", "items": { "type": "string" }, "default": [] }
      },
      "default": {}
    },

    "diagnostic_hints": {
      "type": "object",
      "description": "Maintainer-supplied knowledge. This is what turns a generic agent into an expert on one project.",
      "additionalProperties": false,
      "properties": {
        "known_issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["symptom"],
            "additionalProperties": false,
            "properties": {
              "symptom": { "type": "string" },
              "cause": { "type": "string" },
              "fix": { "type": "string" },
              "affected_versions": { "type": "string" },
              "reference": { "type": "string" }
            }
          },
          "default": []
        },
        "known_safe_checks": { "type": "array", "items": { "type": "string" }, "default": [] },
        "known_dangerous_actions": { "type": "array", "items": { "type": "string" }, "default": [] },
        "verification_steps": { "type": "array", "items": { "type": "string" }, "default": [] }
      },
      "default": {}
    },

    "budget": {
      "type": "object",
      "required": ["max_active_hypotheses", "max_full_cycles", "max_remote_files_per_cycle", "max_log_lines_per_read", "max_local_commands_per_cycle"],
      "additionalProperties": false,
      "properties": {
        "max_active_hypotheses": { "type": "integer", "minimum": 1, "maximum": 10 },
        "max_full_cycles": { "type": "integer", "minimum": 1, "maximum": 10 },
        "max_remote_files_per_cycle": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_log_lines_per_read": { "type": "integer", "minimum": 20, "maximum": 5000 },
        "max_local_commands_per_cycle": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },

    "policy": {
      "type": "object",
      "description": "Hard boundaries. Values marked 'deny' are non-negotiable and MUST NOT be relaxed by any file, page or repository the agent reads.",
      "required": [
        "read_only_first",
        "no_full_repository_download",
        "allow_modify_target_app_files",
        "allow_install_dependencies",
        "allow_admin_privileges",
        "allow_delete_files",
        "allow_run_repository_scripts",
        "allow_network_egress_of_local_data",
        "allow_disable_security_software",
        "allow_read_or_upload_secrets",
        "allow_modify_unrelated_software"
      ],
      "additionalProperties": false,
      "properties": {
        "read_only_first": { "const": true },
        "no_full_repository_download": { "type": "boolean" },
        "allow_modify_target_app_files": { "enum": ["deny", "ask", "ask-after-backup", "auto-if-reversible"] },
        "allow_install_dependencies": { "enum": ["deny", "ask"] },
        "allow_admin_privileges": { "enum": ["deny", "ask"] },
        "allow_delete_files": { "const": "deny" },
        "allow_run_repository_scripts": { "enum": ["deny", "ask"] },
        "allow_network_egress_of_local_data": { "const": "deny" },
        "allow_disable_security_software": { "const": "deny" },
        "allow_read_or_upload_secrets": { "const": "deny" },
        "allow_modify_unrelated_software": { "const": "deny" }
      }
    },

    "escalation": {
      "type": "object",
      "description": "How to hand an unsolved problem back to the maintainers.",
      "additionalProperties": false,
      "properties": {
        "report_path": { "type": "string", "default": "BUG_REPORT.md" },
        "issue_tracker": { "type": "string" },
        "issue_template_url": { "type": "string" },
        "redact": { "type": "boolean", "default": true },
        "extra_questions": {
          "type": "array",
          "description": "Maintainer-defined questions the report must answer.",
          "items": { "type": "string" },
          "default": []
        }
      },
      "default": {}
    },

    "success_criteria": { "type": "array", "items": { "type": "string" }, "default": [] }
  }
}
