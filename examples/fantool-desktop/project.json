{
  "protocol": "bugbridge/project",
  "protocol_version": "1.0",
  "project": {
    "name": "FanTool",
    "repository": "https://github.com/example/fantool",
    "repository_public": true,
    "mirrors": [
      {
        "url": "https://gitcode.com/example/fantool",
        "kind": "gitcode",
        "note": "Pull mirror, synced hourly. Confirm the tag exists before trusting it."
      }
    ],
    "deepwiki": true,
    "docs_url": "https://fantool.example.com/docs",
    "issue_tracker": "https://github.com/example/fantool/issues"
  },
  "defaults": {
    "language": "zh-CN",
    "region": "china",
    "autonomy": "guided",
    "budget_profile": "frugal"
  },
  "environment": {
    "supported_os": ["Windows", "macOS"],
    "runtimes": [".NET 8 Desktop Runtime"]
  },
  "local_targets": {
    "any": {
      "data_paths": ["profiles/"]
    },
    "windows": {
      "installation_paths": ["%LOCALAPPDATA%\\Programs\\FanTool"],
      "executable_paths": ["%LOCALAPPDATA%\\Programs\\FanTool\\FanTool.exe"],
      "log_paths": ["%APPDATA%\\FanTool\\logs"],
      "config_paths": ["%APPDATA%\\FanTool\\config.json"],
      "data_paths": ["%APPDATA%\\FanTool\\profiles"],
      "process_names": ["FanTool.exe", "FanTool.Service.exe"],
      "service_names": ["FanToolMonitor"],
      "registry_paths_read_only": ["HKCU\\Software\\FanTool"]
    },
    "macos": {
      "installation_paths": ["/Applications/FanTool.app"],
      "log_paths": ["~/Library/Logs/FanTool"],
      "config_paths": ["~/Library/Application Support/FanTool/config.json"],
      "process_names": ["FanTool"]
    }
  },
  "diagnostic_hints": {
    "known_issues": [
      {
        "symptom": "点「导入配置」后完全没有反应，也没有报错",
        "cause": "1.3.x 在导入过程中崩溃会留下写了一半的 config.json，之后每次启动解析失败但异常被静默吞掉",
        "fix": "用同目录下的 config.json.bak 覆盖 config.json，然后重启软件",
        "affected_versions": "< 1.4.0",
        "reference": "https://github.com/example/fantool/issues/812"
      },
      {
        "symptom": "风扇转速读数一直是 0",
        "cause": "FanToolMonitor 服务没有运行，或被安全软件拦截了驱动加载",
        "fix": "确认服务状态。若服务被拦截，只报告给用户，不要试图关闭任何安全软件。",
        "affected_versions": "all"
      }
    ],
    "known_safe_checks": [
      "确认 config.json 是合法 JSON",
      "确认 FanToolMonitor 服务是否在运行",
      "对比 logs/ 里最新一份日志的时间戳和用户报告的故障时间"
    ],
    "known_dangerous_actions": [
      "绝不要删除 profiles/ 目录 —— 那是用户手工调的风扇曲线，没有云端备份",
      "绝不要为了让驱动加载而关闭或临时停用任何安全软件；发现这种情况直接写进报告"
    ],
    "verification_steps": [
      "重启 FanTool，确认主界面能读到实时转速",
      "重新执行一次用户原本失败的那个操作"
    ]
  },
  "policy_overrides": {
    "allow_run_repository_scripts": "deny"
  },
  "escalation": {
    "report_path": "BUG_REPORT.md",
    "redact": true,
    "extra_questions": [
      "主板型号和 BIOS 版本是什么？",
      "是否安装了其他风扇控制软件（如 Argus Monitor、SpeedFan）？"
    ]
  }
}
